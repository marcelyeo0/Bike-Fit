// Couche donnees Axio.
//
// Regle produit : AUCUNE video n'est stockee. Les fichiers sont traites en
// memoire puis supprimes ; seules les mesures chiffrees et les recommandations
// qui en decoulent sont persistees (voir modele Study).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum SubscriptionStatus {
  NONE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum Plan {
  FREE
  ESSENTIEL
  ATELIER
  MULTI
}

enum StudyStatus {
  DRAFT
  PROCESSING
  COMPLETED
  FAILED
}

enum Joint {
  KNEE
  HIP
  ELBOW
  SHOULDER
  ANKLE
}

enum MeasurementStatus {
  OK
  WARNING
  OUT
}

/// La pratique pour laquelle le velo est regle. Les fourchettes cibles en
/// dependent.
enum Pratique {
  ROUTE
  GRAVEL
  CHRONO
}

/// Ce que le cycliste attend du reglage.
enum Objectif {
  CONFORT
  MIXTE
  AERO
}

/// Le velociste. `clerkId` fait le lien avec la session Clerk ; c'est la seule
/// cle par laquelle le code serveur retrouve un utilisateur.
model User {
  id                  String             @id @default(cuid())
  clerkId             String             @unique
  email               String             @unique
  name                String?
  role                Role               @default(USER)
  stripeCustomerId    String?            @unique
  subscriptionStatus  SubscriptionStatus @default(NONE)
  plan                Plan               @default(FREE)
  /// Dernier numero de code client attribue par cet atelier. Incremente dans
  /// la meme transaction que la creation du client : l'UPDATE verrouille la
  /// ligne, deux creations simultanees ne peuvent donc pas tirer le meme
  /// numero. Jamais decremente — un code supprime n'est pas reattribue.
  dernierNumeroClient Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  clients Client[]
  studies Study[]
}

/// Le client final du velociste — la personne qui vient se faire regler son velo.
///
/// Regle produit : le serveur ne connait PAS l'identite du cycliste. Ni nom,
/// ni e-mail, ni telephone, ni texte libre (un champ de commentaire finit
/// toujours par contenir un nom ou une information de sante). Le client n'est
/// qu'un code propre a l'atelier ; la correspondance code <-> personne reste en
/// boutique.
model Client {
  id     String @id @default(cuid())
  userId String

  /// Pseudonyme, format `AX-0001`. Sequentiel par atelier, genere cote
  /// serveur (voir `User.dernierNumeroClient`), jamais saisi.
  code String

  /// Mensurations saisies a la main, en centimetres. Optionnelles.
  tailleCm     Float?
  entrejambeCm Float?

  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  studies Study[]

  /// Seconde barriere contre les doublons de code, apres le compteur.
  @@unique([userId, code])
  @@index([userId])
}

/// Une seance d'analyse posturale. Ne contient aucun media : uniquement le
/// resultat de l'analyse.
model Study {
  id String @id @default(cuid())

  userId String

  /// Nullable par precaution d'architecture, pas par besoin actuel : aucune
  /// interface ne cree aujourd'hui d'etude sans client. Passer une colonne de
  /// NOT NULL a NULL est gratuit ; l'inverse impose de trouver une valeur pour
  /// chaque ligne existante. On paie le champ maintenant pour ne pas payer la
  /// migration plus tard, le jour ou une etude devra exister avant sa fiche
  /// client (essai en atelier, seance decouverte, import d'historique).
  clientId String?

  /// Libelle de repli quand `clientId` est nul. Non expose dans l'interface
  /// pour l'instant : il n'existe encore aucun chemin de creation sans client.
  titre String?

  /// Nullables : les etudes creees avant l'ajout de ces colonnes n'ont pas de
  /// valeur, et en inventer une fausserait leur lecture. Toute nouvelle etude
  /// les renseigne — la server action de creation les exige.
  pratique Pratique?
  objectif Objectif?

  status      StudyStatus @default(DRAFT)
  isDemo      Boolean     @default(false)
  createdAt   DateTime    @default(now())
  completedAt DateTime?

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  client          Client?          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  measurements    Measurement[]
  recommendations Recommendation[]

  @@index([userId])
  @@index([clientId])
}

/// Un angle articulaire mesure, avec la fourchette cible retenue pour CETTE
/// etude. La cible est copiee ici plutot que referencee : les fourchettes
/// dependent du questionnaire et peuvent evoluer, un rapport doit rester lisible
/// tel qu'il a ete produit.
model Measurement {
  id        String            @id @default(cuid())
  studyId   String
  joint     Joint
  value     Float
  targetMin Float
  targetMax Float
  status    MeasurementStatus

  study Study @relation(fields: [studyId], references: [id], onDelete: Cascade)

  @@index([studyId])
}

/// Conseil de reglage. `joint` est nullable : certaines recommandations portent
/// sur la position globale, pas sur une articulation en particulier.
model Recommendation {
  id       String @id @default(cuid())
  studyId  String
  joint    Joint?
  text     String
  priority Int    @default(0)

  study Study @relation(fields: [studyId], references: [id], onDelete: Cascade)

  @@index([studyId])
}
