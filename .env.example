# ---------------------------------------------------------------------------
# Clerk — authentification
# ---------------------------------------------------------------------------
# Copier ce fichier en `.env` puis remplir les cles. Avec Docker, ce sont
# les seules valeurs a renseigner : le reste a des valeurs par defaut.
# Elles se recuperent dans le dashboard Clerk : https://dashboard.clerk.com
# > votre application > API keys > Next.js.
#
# `.env` est ignore par git (voir .gitignore). Ne jamais committer la
# cle secrete.

# Cle publique, exposee au navigateur (prefixe NEXT_PUBLIC_). Comme toutes
# les NEXT_PUBLIC_*, elle est figee dans le bundle au build : apres l'avoir
# changee, relancer `docker compose up --build`.
# Format : pk_test_... en developpement, pk_live_... en production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cle secrete, cote serveur uniquement (middleware, currentUser()).
# Format : sk_test_... en developpement, sk_live_... en production.
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Clerk — routes d'authentification
# ---------------------------------------------------------------------------
# Ou vivent nos pages. Sans ces variables, Clerk renverrait vers son Account
# Portal hebergé au lieu de nos pages locales.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ---------------------------------------------------------------------------
# Clerk — redirections apres authentification
# ---------------------------------------------------------------------------
# Clerk resout la destination dans cet ordre :
#   1. FORCE_REDIRECT_URL       (ecrase tout)
#   2. le parametre `redirect_url` de l'URL, pose par le middleware
#   3. FALLBACK_REDIRECT_URL
#
# Inscription : on veut toujours /dashboard, donc FORCE.
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Connexion : uniquement FALLBACK. Poser un FORCE ici ecraserait
# `redirect_url` et empecherait le retour sur la page demandee apres une
# redirection du middleware (/dashboard, /admin).
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard

# ---------------------------------------------------------------------------
# Clerk — webhook de synchronisation
# ---------------------------------------------------------------------------
# Secret de signature du webhook, a creer dans le dashboard Clerk :
# Configure > Webhooks > Add Endpoint. Format : whsec_...
#
# Il ne sert QU'A verifier la signature `svix-*` des requetes entrantes sur
# /api/webhooks/clerk. Sans lui, la route rejette tout en 400.
#
# Clerk lit par defaut CLERK_WEBHOOK_SIGNING_SECRET ; le code accepte les deux
# noms, celui-ci en priorite.
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Gemini — fourchettes d'angle de la seance (optionnel)
# ---------------------------------------------------------------------------
# Cle d'API Google AI Studio : https://aistudio.google.com/apikey
#
# A l'ouverture d'une seance, le serveur demande a Gemini les fourchettes
# cibles et les consignes pour le profil du cycliste. Ne partent que la
# pratique, l'objectif, la taille et l'entrejambe — ni code client, ni image.
# Un seul appel par etude, puis le resultat est fige sur l'etude.
#
# Laisser vide pour ne jamais appeler Google : la table locale
# (src/lib/biomeca/plages.ts) prend le relais, comme a chaque echec de l'appel.
# Secret : cote serveur uniquement, jamais en ARG de build.
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Base de donnees — PostgreSQL (conteneur `db` de compose.yaml)
# ---------------------------------------------------------------------------
# Identifiants crees au premier demarrage du conteneur `db`. Les changer
# ensuite ne modifie pas une base deja initialisee : il faut alors repartir
# d'un volume vide (`docker compose down -v`).
# Eviter les caracteres speciaux d'URL (@ : / ? #) dans le mot de passe, ou
# les encoder dans DATABASE_URL.
POSTGRES_USER=axio
POSTGRES_PASSWORD=axio
POSTGRES_DB=axio

# Port de l'hote sur lequel la base est publiee, en 127.0.0.1 uniquement.
# 5433 par defaut : un Postgres installe sur la machine occupe souvent 5432.
AXIO_DB_PORT=5433

# Port de l'hote pour l'application lancee par `docker compose up`.
AXIO_WEB_PORT=3000

# URL lue DEPUIS L'HOTE : `npm run dev`, `npm run seed`, `npm run db:verify`,
# `npx prisma migrate dev`. Elle vise `localhost` et le port publie ci-dessus.
#
# Les conteneurs `web` et `migrate` ne la lisent pas : compose.yaml leur
# construit la leur a partir de POSTGRES_*, avec l'hote `db`. Le meme .env
# sert donc aux deux usages.
#
# Format : postgresql://UTILISATEUR:MOTDEPASSE@HOTE:PORT/BASE?schema=public
DATABASE_URL=postgresql://axio:axio@localhost:5433/axio?schema=public

# 1 (defaut) : le service `migrate` charge le jeu de demonstration apres les
# migrations. 0 : migrations seules.
AXIO_SEED=1

# ---------------------------------------------------------------------------
# Production uniquement (compose.prod.yaml)
# ---------------------------------------------------------------------------
# Domaine servi par Caddy, qui en obtient le certificat HTTPS.
# AXIO_DOMAINE=app.exemple.fr
